-- ============================================================================
-- 2. BRIDGE_12 (#50): Non-Scalar Krein-Holonomy Phase Detector K_t Over Z and Z[sqrt(5)]
-- ============================================================================

structure Vec3Z where
  x : Int
  y : Int
  z : Int
  deriving DecidableEq, Repr

structure Mat3Z where
  r0 : Vec3Z
  r1 : Vec3Z
  r2 : Vec3Z
  deriving DecidableEq, Repr

def vec3Dot (u v : Vec3Z) : Int :=
  u.x * v.x + u.y * v.y + u.z * v.z

def mat3Vec (m : Mat3Z) (v : Vec3Z) : Vec3Z :=
  ⟨vec3Dot m.r0 v, vec3Dot m.r1 v, vec3Dot m.r2 v⟩

def quadForm3 (m : Mat3Z) (v : Vec3Z) : Int :=
  vec3Dot v (mat3Vec m v)

def mat3Trans (m : Mat3Z) : Mat3Z :=
  ⟨⟨m.r0.x, m.r1.x, m.r2.x⟩,
   ⟨m.r0.y, m.r1.y, m.r2.y⟩,
   ⟨m.r0.z, m.r1.z, m.r2.z⟩⟩

def mat3Mul (a b : Mat3Z) : Mat3Z :=
  let bt := mat3Trans b
  ⟨⟨vec3Dot a.r0 bt.r0, vec3Dot a.r0 bt.r1, vec3Dot a.r0 bt.r2⟩,
   ⟨vec3Dot a.r1 bt.r0, vec3Dot a.r1 bt.r1, vec3Dot a.r1 bt.r2⟩,
   ⟨vec3Dot a.r2 bt.r0, vec3Dot a.r2 bt.r1, vec3Dot a.r2 bt.r2⟩⟩

def mat3Cong (p m : Mat3Z) : Mat3Z :=
  mat3Mul (mat3Trans p) (mat3Mul m p)

def vec3Scale (s : Int) (v : Vec3Z) : Vec3Z :=
  ⟨s * v.x, s * v.y, s * v.z⟩

def mat3Scale (s : Int) (m : Mat3Z) : Mat3Z :=
  ⟨vec3Scale s m.r0, vec3Scale s m.r1, vec3Scale s m.r2⟩

def vec3Sub (a b : Vec3Z) : Vec3Z :=
  ⟨a.x - b.x, a.y - b.y, a.z - b.z⟩

def mat3Sub (a b : Mat3Z) : Mat3Z :=
  ⟨vec3Sub a.r0 b.r0, vec3Sub a.r1 b.r1, vec3Sub a.r2 b.r2⟩

def mat3Diag (d0 d1 d2 : Int) : Mat3Z :=
  ⟨⟨d0, 0, 0⟩, ⟨0, d1, 0⟩, ⟨0, 0, d2⟩⟩

def mat3Id : Mat3Z :=
  mat3Diag 1 1 1

def mat3Trace (m : Mat3Z) : Int :=
  m.r0.x + m.r1.y + m.r2.z

def mat3MinorSum (m : Mat3Z) : Int :=
  (m.r0.x * m.r1.y - m.r0.y * m.r1.x) +
  (m.r0.x * m.r2.z - m.r0.z * m.r2.x) +
  (m.r1.y * m.r2.z - m.r1.z * m.r2.y)

def mat3Det (m : Mat3Z) : Int :=
  m.r0.x * (m.r1.y * m.r2.z - m.r1.z * m.r2.y) -
  m.r0.y * (m.r1.x * m.r2.z - m.r1.z * m.r2.x) +
  m.r0.z * (m.r1.x * m.r2.y - m.r1.y * m.r2.x)

def mat3CharPoly (m : Mat3Z) : Int × Int × Int :=
  (mat3Trace m, mat3MinorSum m, mat3Det m)

/-- Constructive DecidableEq check for SO(3, Z) (avoids Int BEq Classical.choice!). -/
def isSO3Z (u : Mat3Z) : Bool :=
  decide (mat3Mul (mat3Trans u) u = mat3Id) && decide (mat3Det u = 1)

def signCount3 (d0 d1 d2 : Int) : Nat × Nat × Nat :=
  let pos := (if 0 < d0 then 1 else 0) + (if 0 < d1 then 1 else 0) + (if 0 < d2 then 1 else 0)
  let neg := (if d0 < 0 then 1 else 0) + (if d1 < 0 then 1 else 0) + (if d2 < 0 then 1 else 0)
  let zer := (if d0 = 0 then 1 else 0) + (if d1 = 0 then 1 else 0) + (if d2 = 0 then 1 else 0)
  (pos, neg, zer)

def diagInertia3 (m : Mat3Z) : Nat × Nat × Nat :=
  signCount3 m.r0.x m.r1.y m.r2.z

def lDiag5 : Mat3Z := mat3Diag 3 6 3
def g311 : Mat3Z := mat3Diag 3 1 1
def g114 : Mat3Z := mat3Diag 1 1 4

def uCyc : Mat3Z :=
  ⟨⟨0, 1, 0⟩, ⟨0, 0, 1⟩, ⟨1, 0, 0⟩⟩

def rhoGBeta : Mat3Z :=
  ⟨⟨0, -1, 0⟩, ⟨0, 0, 1⟩, ⟨-1, 0, 0⟩⟩

def kreinDefectUL25 (g u l5 : Mat3Z) : Mat3Z :=
  mat3Sub (mat3Scale 25 g) (mat3Cong (mat3Mul u l5) g)

def kreinDefectLU25 (g u l5 : Mat3Z) : Mat3Z :=
  mat3Sub (mat3Scale 25 g) (mat3Cong (mat3Mul l5 u) g)

private theorem vec3_ext {u v : Vec3Z} (hx : u.x = v.x) (hy : u.y = v.y) (hz : u.z = v.z) : u = v := by
  cases u
  cases v
  simp only at hx hy hz
  subst hx hy hz
  rfl

private theorem mul_reassoc_comm (u p w : Int) : u * (p * w) = p * u * w := by
  rw [← Int.mul_assoc u p w, Int.mul_comm u p]

private theorem mat3Mul_vec (a b : Mat3Z) (v : Vec3Z) :
    mat3Vec (mat3Mul a b) v = mat3Vec a (mat3Vec b v) := by
  apply vec3_ext <;>
    simp only [mat3Vec, mat3Mul, mat3Trans, vec3Dot, Int.add_mul, Int.mul_add, Int.mul_assoc] <;>
    omega

private theorem mat3Trans_dot (p : Mat3Z) (u w : Vec3Z) :
    vec3Dot u (mat3Vec (mat3Trans p) w) = vec3Dot (mat3Vec p u) w := by
  simp only [mat3Vec, mat3Trans, vec3Dot, Int.mul_add, Int.add_mul, mul_reassoc_comm]
  omega

private theorem mat3Cong_quadForm (p m : Mat3Z) (v : Vec3Z) :
    quadForm3 (mat3Cong p m) v = quadForm3 m (mat3Vec p v) := by
  unfold quadForm3 mat3Cong
  rw [mat3Mul_vec, mat3Mul_vec, mat3Trans_dot]

private theorem mat3Scale_quadForm (s : Int) (m : Mat3Z) (v : Vec3Z) :
    quadForm3 (mat3Scale s m) v = s * quadForm3 m v := by
  simp only [quadForm3, mat3Scale, mat3Vec, vec3Scale, vec3Dot, Int.mul_add, Int.mul_assoc, Int.mul_left_comm]

private theorem quadForm3_diag (d0 d1 d2 : Int) (u : Vec3Z) :
    quadForm3 (mat3Diag d0 d1 d2) u = d0 * (u.x * u.x) + d1 * (u.y * u.y) + d2 * (u.z * u.z) := by
  dsimp only [quadForm3, mat3Diag, mat3Vec, vec3Dot]
  simp only [Int.zero_mul, Int.add_zero, Int.zero_add]
  rw [Int.mul_comm u.x (d0 * u.x), Int.mul_assoc d0 u.x u.x,
      Int.mul_comm u.y (d1 * u.y), Int.mul_assoc d1 u.y u.y,
      Int.mul_comm u.z (d2 * u.z), Int.mul_assoc d2 u.z u.z]

private theorem int_sq_nonneg (t : Int) : 0 ≤ t * t :=
  if h : 0 ≤ t then
    Int.mul_nonneg h h
  else by
    have hn : 0 ≤ -t := by omega
    have heq : (-t) * (-t) = t * t := by simp only [Int.neg_mul_neg]
    rw [← heq]
    exact Int.mul_nonneg hn hn

private theorem int_sq_pos_of_ne_zero {t : Int} (ht : t ≠ 0) : 0 < t * t :=
  if hp : 0 < t then
    Int.mul_pos hp hp
  else by
    have hn : 0 < -t := by omega
    have heq : (-t) * (-t) = t * t := by simp only [Int.neg_mul_neg]
    rw [← heq]
    exact Int.mul_pos hn hn

private theorem int_eq_zero_of_sq_le_zero {t : Int} (h : t * t ≤ 0) : t = 0 :=
  if hz : t = 0 then
    hz
  else by
    have hp := int_sq_pos_of_ne_zero hz
    omega

private theorem int_sq_le_one_cases (t : Int) (h : t * t ≤ 1) : t = -1 ∨ t = 0 ∨ t = 1 :=
  if hge2 : 2 ≤ t then by
    have d1 : 0 ≤ t - 2 := by omega
    have prod : 0 ≤ (t - 2) * (t + 2) := Int.mul_nonneg d1 (by omega)
    simp only [Int.sub_eq_add_neg, Int.add_mul, Int.mul_add, Int.neg_mul] at prod
    omega
  else if hle2 : t ≤ -2 then by
    have d1 : 0 ≤ -t - 2 := by omega
    have prod : 0 ≤ (-t - 2) * (-t + 2) := Int.mul_nonneg d1 (by omega)
    simp only [Int.sub_eq_add_neg, Int.add_mul, Int.mul_add, Int.neg_mul, Int.mul_neg] at prod
    omega
  else by
    omega

private theorem sylvester_no_cong_lu_to_ul
    (p : Mat3Z) {c1 c2 : Int} (hc1 : 0 < c1) (hc2 : 0 < c2)
    (heq : mat3Scale c1 (mat3Cong p (kreinDefectLU25 g311 uCyc lDiag5)) =
           mat3Scale c2 (kreinDefectUL25 g311 uCyc lDiag5)) : False := by
  have hmul : kreinDefectUL25 g311 uCyc lDiag5 = mat3Diag 66 (-83) 16 := by decide
  have hmlu : kreinDefectLU25 g311 uCyc lDiag5 = mat3Diag 66 (-2) (-11) := by decide
  rw [hmul, hmlu] at heq
  have hq : ∀ v : Vec3Z,
      c1 * quadForm3 (mat3Diag 66 (-2) (-11)) (mat3Vec p v) =
        c2 * quadForm3 (mat3Diag 66 (-83) 16) v := by
    intro v
    have hv := congrArg (fun m => quadForm3 m v) heq
    rw [mat3Scale_quadForm, mat3Scale_quadForm, mat3Cong_quadForm] at hv
    exact hv
  have h_p0x : p.r0.x = 0 :=
    if h0 : p.r0.x = 0 then
      h0
    else by
      let v0 : Vec3Z := ⟨p.r0.z, 0, -p.r0.x⟩
      have hv0 := hq v0
      have hpx0 : (mat3Vec p v0).x = 0 := by
        dsimp only [mat3Vec, vec3Dot, v0]
        simp only [Int.mul_zero, Int.add_zero, Int.mul_neg, Int.mul_comm]
        omega
      have hlhs : quadForm3 (mat3Diag 66 (-2) (-11)) (mat3Vec p v0) ≤ 0 := by
        rw [quadForm3_diag, hpx0]
        have hy2 := int_sq_nonneg (mat3Vec p v0).y
        have hz2 := int_sq_nonneg (mat3Vec p v0).z
        omega
      have hrhs : 0 < quadForm3 (mat3Diag 66 (-83) 16) v0 := by
        rw [quadForm3_diag]
        dsimp only [v0]
        simp only [Int.neg_mul_neg]
        have hz2 := int_sq_nonneg p.r0.z
        have hx2 := int_sq_pos_of_ne_zero h0
        omega
      have hc1_le : c1 * quadForm3 (mat3Diag 66 (-2) (-11)) (mat3Vec p v0) ≤ 0 :=
        Int.mul_nonpos_of_nonneg_of_nonpos (by omega) hlhs
      have hc2_pos : 0 < c2 * quadForm3 (mat3Diag 66 (-83) 16) v0 := Int.mul_pos hc2 hrhs
      omega
  let e0 : Vec3Z := ⟨1, 0, 0⟩
  have he0 := hq e0
  have hpe0x : (mat3Vec p e0).x = 0 := by
    dsimp only [mat3Vec, vec3Dot, e0]
    rw [h_p0x]
    omega
  have hlhs0 : quadForm3 (mat3Diag 66 (-2) (-11)) (mat3Vec p e0) ≤ 0 := by
    rw [quadForm3_diag, hpe0x]
    have hy2 := int_sq_nonneg (mat3Vec p e0).y
    have hz2 := int_sq_nonneg (mat3Vec p e0).z
    omega
  have hrhs0 : quadForm3 (mat3Diag 66 (-83) 16) e0 = 66 := by decide
  rw [hrhs0] at he0
  have hc1_le0 : c1 * quadForm3 (mat3Diag 66 (-2) (-11)) (mat3Vec p e0) ≤ 0 :=
    Int.mul_nonpos_of_nonneg_of_nonpos (by omega) hlhs0
  omega

private theorem sylvester_no_cong_ul_to_lu
    (p : Mat3Z) {c1 c2 : Int} (hc1 : 0 < c1) (hc2 : 0 < c2)
    (heq : mat3Scale c1 (mat3Cong p (kreinDefectUL25 g311 uCyc lDiag5)) =
           mat3Scale c2 (kreinDefectLU25 g311 uCyc lDiag5)) : False := by
  have hmul : kreinDefectUL25 g311 uCyc lDiag5 = mat3Diag 66 (-83) 16 := by decide
  have hmlu : kreinDefectLU25 g311 uCyc lDiag5 = mat3Diag 66 (-2) (-11) := by decide
  rw [hmul, hmlu] at heq
  have hq : ∀ v : Vec3Z,
      c1 * quadForm3 (mat3Diag 66 (-83) 16) (mat3Vec p v) =
        c2 * quadForm3 (mat3Diag 66 (-2) (-11)) v := by
    intro v
    have hv := congrArg (fun m => quadForm3 m v) heq
    rw [mat3Scale_quadForm, mat3Scale_quadForm, mat3Cong_quadForm] at hv
    exact hv
  have h_p1y : p.r1.y = 0 :=
    if h0 : p.r1.y = 0 then
      h0
    else by
      let w0 : Vec3Z := ⟨0, p.r1.z, -p.r1.y⟩
      have hw0 := hq w0
      have hpy0 : (mat3Vec p w0).y = 0 := by
        dsimp only [mat3Vec, vec3Dot, w0]
        simp only [Int.mul_zero, Int.zero_add, Int.mul_neg, Int.mul_comm]
        omega
      have hlhs : 0 ≤ quadForm3 (mat3Diag 66 (-83) 16) (mat3Vec p w0) := by
        rw [quadForm3_diag, hpy0]
        have hx2 := int_sq_nonneg (mat3Vec p w0).x
        have hz2 := int_sq_nonneg (mat3Vec p w0).z
        omega
      have hrhs : quadForm3 (mat3Diag 66 (-2) (-11)) w0 < 0 := by
        rw [quadForm3_diag]
        dsimp only [w0]
        simp only [Int.neg_mul_neg]
        have hz2 := int_sq_nonneg p.r1.z
        have hy2 := int_sq_pos_of_ne_zero h0
        omega
      have hc1_ge : 0 ≤ c1 * quadForm3 (mat3Diag 66 (-83) 16) (mat3Vec p w0) :=
        Int.mul_nonneg (by omega) hlhs
      have hc2_neg : c2 * quadForm3 (mat3Diag 66 (-2) (-11)) w0 < 0 :=
        Int.mul_neg_of_pos_of_neg hc2 hrhs
      omega
  let e1 : Vec3Z := ⟨0, 1, 0⟩
  have he1 := hq e1
  have hpe1y : (mat3Vec p e1).y = 0 := by
    dsimp only [mat3Vec, vec3Dot, e1]
    rw [h_p1y]
    omega
  have hlhs1 : 0 ≤ quadForm3 (mat3Diag 66 (-83) 16) (mat3Vec p e1) := by
    rw [quadForm3_diag, hpe1y]
    have hx2 := int_sq_nonneg (mat3Vec p e1).x
    have hz2 := int_sq_nonneg (mat3Vec p e1).z
    omega
  have hrhs1 : quadForm3 (mat3Diag 66 (-2) (-11)) e1 = -2 := by decide
  rw [hrhs1] at he1
  have hc1_ge1 : 0 ≤ c1 * quadForm3 (mat3Diag 66 (-83) 16) (mat3Vec p e1) :=
    Int.mul_nonneg (by omega) hlhs1
  omega

-- ----------------------------------------------------------------------------
-- 2.2 Universal 4th Scalar Holonomy Block h(Delta U) = 3 - (2*q_0)^2
-- ----------------------------------------------------------------------------

structure QuatZ where
  w : Int
  x : Int
  y : Int
  z : Int
  deriving DecidableEq, Repr

def qzPosI : QuatZ := ⟨1, 0, 0, 0⟩
def qzNegI : QuatZ := ⟨-1, 0, 0, 0⟩

def qzNeg (q : QuatZ) : QuatZ :=
  ⟨-q.w, -q.x, -q.y, -q.z⟩

def qzNormSq (q : QuatZ) : Int :=
  q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z

def holonomyBlockZ (q : QuatZ) : Int :=
  3 - (2 * q.w) * (2 * q.w)

private theorem qz_ext {p q : QuatZ}
    (hw : p.w = q.w) (hx : p.x = q.x) (hy : p.y = q.y) (hz : p.z = q.z) : p = q := by
  cases p
  cases q
  simp only at hw hx hy hz
  subst hw hx hy hz
  rfl

private theorem holonomyBlockZ_unit_dichotomy (q : QuatZ) (hunit : qzNormSq q = 1) :
    holonomyBlockZ (qzNeg q) = holonomyBlockZ q ∧
    holonomyBlockZ q ≠ 0 ∧
    (holonomyBlockZ q < 0 ↔ (q = qzPosI ∨ q = qzNegI)) ∧
    ((q = qzPosI ∨ q = qzNegI) → holonomyBlockZ q = -1) ∧
    ((q ≠ qzPosI ∧ q ≠ qzNegI) → holonomyBlockZ q = 3) := by
  have hw2 := int_sq_nonneg q.w
  have hx2 := int_sq_nonneg q.x
  have hy2 := int_sq_nonneg q.y
  have hz2 := int_sq_nonneg q.z
  unfold qzNormSq at hunit
  have hw_le : q.w * q.w ≤ 1 := by omega
  have hw_cases := int_sq_le_one_cases q.w hw_le
  have hsym : holonomyBlockZ (qzNeg q) = holonomyBlockZ q := by
    dsimp only [holonomyBlockZ, qzNeg]
    simp only [Int.mul_neg, Int.neg_mul, Int.neg_neg]
  rcases hw_cases with hw_m1 | hw_0 | hw_p1
  · rw [hw_m1] at hunit
    have hx0 : q.x = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hy0 : q.y = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hz0 : q.z = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hq_eq : q = qzNegI := qz_ext hw_m1 hx0 hy0 hz0
    subst hq_eq
    exact ⟨hsym, by decide, by decide, fun _ => by decide, fun h => False.elim (h.2 rfl)⟩
  · have hval : holonomyBlockZ q = 3 := by
      dsimp only [holonomyBlockZ]
      rw [hw_0]
      decide
    have hne_pos : q ≠ qzPosI := by
      intro he
      have := congrArg QuatZ.w he
      dsimp only [qzPosI] at this
      omega
    have hne_neg : q ≠ qzNegI := by
      intro he
      have := congrArg QuatZ.w he
      dsimp only [qzNegI] at this
      omega
    refine ⟨hsym, by omega, ?_, ?_, fun _ => hval⟩
    · constructor
      · intro hlt
        omega
      · intro hor
        rcases hor with hp | hn
        · exact False.elim (hne_pos hp)
        · exact False.elim (hne_neg hn)
    · intro hor
      rcases hor with hp | hn
      · exact False.elim (hne_pos hp)
      · exact False.elim (hne_neg hn)
  · rw [hw_p1] at hunit
    have hx0 : q.x = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hy0 : q.y = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hz0 : q.z = 0 := int_eq_zero_of_sq_le_zero (by omega)
    have hq_eq : q = qzPosI := qz_ext hw_p1 hx0 hy0 hz0
    subst hq_eq
    exact ⟨hsym, by decide, by decide, fun _ => by decide, fun h => False.elim (h.1 rfl)⟩

/-- Exact quadratic integer a + b*sqrt(5) in Z[sqrt(5)] and scale-4 2I subset SU(2). -/
structure ZSqrt5 where
  a : Int
  b : Int
  deriving DecidableEq, Repr

def z5Zero : ZSqrt5 := ⟨0, 0⟩

def z5Neg (x : ZSqrt5) : ZSqrt5 :=
  ⟨-x.a, -x.b⟩

def z5Add (x y : ZSqrt5) : ZSqrt5 :=
  ⟨x.a + y.a, x.b + y.b⟩

def z5Sub (x y : ZSqrt5) : ZSqrt5 :=
  ⟨x.a - y.a, x.b - y.b⟩

def z5Scale (s : Int) (x : ZSqrt5) : ZSqrt5 :=
  ⟨s * x.a, s * x.b⟩

def z5Mul (x y : ZSqrt5) : ZSqrt5 :=
  ⟨x.a * y.a + 5 * x.b * y.b, x.a * y.b + x.b * y.a⟩

def z5Sq (x : ZSqrt5) : ZSqrt5 :=
  z5Mul x x

def z5Div4 (x : ZSqrt5) : ZSqrt5 :=
  ⟨x.a / 4, x.b / 4⟩

def z5PosB (z : ZSqrt5) : Bool :=
  (decide (0 ≤ z.a) && decide (0 ≤ z.b) && decide (0 < z.a + z.b)) ||
  (decide (0 < z.a) && decide (z.b < 0) && decide (5 * (z.b * z.b) < z.a * z.a)) ||
  (decide (z.a < 0) && decide (0 < z.b) && decide (z.a * z.a < 5 * (z.b * z.b)))

structure QuatZ5 where
  w : ZSqrt5
  x : ZSqrt5
  y : ZSqrt5
  z : ZSqrt5
  deriving DecidableEq, Repr

def q5Neg (q : QuatZ5) : QuatZ5 :=
  ⟨z5Neg q.w, z5Neg q.x, z5Neg q.y, z5Neg q.z⟩

def q5NormSq (q : QuatZ5) : ZSqrt5 :=
  z5Add (z5Add (z5Add (z5Sq q.w) (z5Sq q.x)) (z5Sq q.y)) (z5Sq q.z)

def q5MulRaw (p q : QuatZ5) : QuatZ5 :=
  ⟨z5Sub (z5Sub (z5Sub (z5Mul p.w q.w) (z5Mul p.x q.x)) (z5Mul p.y q.y)) (z5Mul p.z q.z),
   z5Sub (z5Add (z5Add (z5Mul p.w q.x) (z5Mul p.x q.w)) (z5Mul p.y q.z)) (z5Mul p.z q.y),
   z5Add (z5Add (z5Sub (z5Mul p.w q.y) (z5Mul p.x q.z)) (z5Mul p.y q.w)) (z5Mul p.z q.x),
   z5Add (z5Sub (z5Add (z5Mul p.w q.z) (z5Mul p.x q.y)) (z5Mul p.y q.x)) (z5Mul p.z q.w)⟩

def uMul2I (p q : QuatZ5) : QuatZ5 :=
  let r := q5MulRaw p q
  ⟨z5Div4 r.w, z5Div4 r.x, z5Div4 r.y, z5Div4 r.z⟩

def I4 : QuatZ5 := ⟨⟨4, 0⟩, z5Zero, z5Zero, z5Zero⟩
def negI4 : QuatZ5 := ⟨⟨-4, 0⟩, z5Zero, z5Zero, z5Zero⟩
def tau0_4 : QuatZ5 := ⟨⟨1, 1⟩, ⟨-1, 1⟩, ⟨2, 0⟩, z5Zero⟩
def gBeta_4 : QuatZ5 := ⟨⟨2, 0⟩, ⟨-2, 0⟩, ⟨2, 0⟩, ⟨2, 0⟩⟩

def holonomyBlock2I_16 (q : QuatZ5) : ZSqrt5 :=
  z5Sub ⟨48, 0⟩ (z5Scale 4 (z5Sq q.w))

def evenPermAt (k : Nat) (x0 x1 x2 x3 : ZSqrt5) : QuatZ5 :=
  match k with
  | 0  => ⟨x0, x1, x2, x3⟩
  | 1  => ⟨x1, x0, x3, x2⟩
  | 2  => ⟨x2, x3, x0, x1⟩
  | 3  => ⟨x3, x2, x1, x0⟩
  | 4  => ⟨x0, x2, x3, x1⟩
  | 5  => ⟨x0, x3, x1, x2⟩
  | 6  => ⟨x2, x1, x3, x0⟩
  | 7  => ⟨x3, x1, x0, x2⟩
  | 8  => ⟨x1, x3, x2, x0⟩
  | 9  => ⟨x3, x0, x2, x1⟩
  | 10 => ⟨x1, x2, x0, x3⟩
  | _  => ⟨x2, x0, x1, x3⟩

def hurwitz16At (m : Fin 16) : QuatZ5 :=
  let b := bitsOfFin16 m
  ⟨⟨if b.c0 then -2 else 2, 0⟩,
   ⟨if b.c1 then -2 else 2, 0⟩,
   ⟨if b.c2 then -2 else 2, 0⟩,
   ⟨if b.c3 then -2 else 2, 0⟩⟩

def goldenSign3 (idx : Nat) : Int × Int × Int :=
  match idx with
  | 0 => ( 1,  1,  1)
  | 1 => ( 1,  1, -1)
  | 2 => ( 1, -1,  1)
  | 3 => ( 1, -1, -1)
  | 4 => (-1,  1,  1)
  | 5 => (-1,  1, -1)
  | 6 => (-1, -1,  1)
  | _ => (-1, -1, -1)

def elem2I (blk : Fin 10) (slt : Fin 12) : QuatZ5 :=
  match blk.val with
  | 0 =>
    match slt.val with
    | 0  => ⟨⟨4, 0⟩, z5Zero, z5Zero, z5Zero⟩
    | 1  => ⟨⟨-4, 0⟩, z5Zero, z5Zero, z5Zero⟩
    | 2  => ⟨z5Zero, ⟨4, 0⟩, z5Zero, z5Zero⟩
    | 3  => ⟨z5Zero, ⟨-4, 0⟩, z5Zero, z5Zero⟩
    | 4  => ⟨z5Zero, z5Zero, ⟨4, 0⟩, z5Zero⟩
    | 5  => ⟨z5Zero, z5Zero, ⟨-4, 0⟩, z5Zero⟩
    | 6  => ⟨z5Zero, z5Zero, z5Zero, ⟨4, 0⟩⟩
    | 7  => ⟨z5Zero, z5Zero, z5Zero, ⟨-4, 0⟩⟩
    | 8  => hurwitz16At ⟨0, by decide⟩
    | 9  => hurwitz16At ⟨1, by decide⟩
    | 10 => hurwitz16At ⟨2, by decide⟩
    | _  => hurwitz16At ⟨3, by decide⟩
  | 1 =>
    match slt.val with
    | 0  => hurwitz16At ⟨4, by decide⟩
    | 1  => hurwitz16At ⟨5, by decide⟩
    | 2  => hurwitz16At ⟨6, by decide⟩
    | 3  => hurwitz16At ⟨7, by decide⟩
    | 4  => hurwitz16At ⟨8, by decide⟩
    | 5  => hurwitz16At ⟨9, by decide⟩
    | 6  => hurwitz16At ⟨10, by decide⟩
    | 7  => hurwitz16At ⟨11, by decide⟩
    | 8  => hurwitz16At ⟨12, by decide⟩
    | 9  => hurwitz16At ⟨13, by decide⟩
    | 10 => hurwitz16At ⟨14, by decide⟩
    | _  => hurwitz16At ⟨15, by decide⟩
  | b =>
    let (s1, s2, s3) := goldenSign3 (b - 2)
    evenPermAt slt.val z5Zero ⟨2 * s1, 0⟩ ⟨-s2, s2⟩ ⟨s3, s3⟩

/-- Fast O(1) zero-Classical.choice membership check on 4*(2I):
    extracts exact (s1, s2, s3) signs and checks the 3 even permutations for the zero slot! -/
def hasCoordZ5 (q : QuatZ5) (t : ZSqrt5) : Bool :=
  decide (q.w = t) || decide (q.x = t) || decide (q.y = t) || decide (q.z = t)

def isEvenPermGolden (q : QuatZ5) : Bool :=
  let s1 : Int := if hasCoordZ5 q ⟨2, 0⟩ then 1 else -1
  let s2 : Int := if hasCoordZ5 q ⟨-1, 1⟩ then 1 else -1
  let s3 : Int := if hasCoordZ5 q ⟨1, 1⟩ then 1 else -1
  let checkAt (k : Nat) : Bool :=
    decide (q = evenPermAt k z5Zero ⟨2 * s1, 0⟩ ⟨-s2, s2⟩ ⟨s3, s3⟩)
  if decide (q.w = z5Zero) then
    checkAt 0 || checkAt 4 || checkAt 5
  else if decide (q.x = z5Zero) then
    checkAt 1 || checkAt 9 || checkAt 11
  else if decide (q.y = z5Zero) then
    checkAt 2 || checkAt 7 || checkAt 10
  else if decide (q.z = z5Zero) then
    checkAt 3 || checkAt 6 || checkAt 8
  else
    false

def isElem2IB (q : QuatZ5) : Bool :=
  let isAxis :=
    decide (q = elem2I ⟨0, by decide⟩ ⟨0, by decide⟩) || decide (q = elem2I ⟨0, by decide⟩ ⟨1, by decide⟩) ||
    decide (q = elem2I ⟨0, by decide⟩ ⟨2, by decide⟩) || decide (q = elem2I ⟨0, by decide⟩ ⟨3, by decide⟩) ||
    decide (q = elem2I ⟨0, by decide⟩ ⟨4, by decide⟩) || decide (q = elem2I ⟨0, by decide⟩ ⟨5, by decide⟩) ||
    decide (q = elem2I ⟨0, by decide⟩ ⟨6, by decide⟩) || decide (q = elem2I ⟨0, by decide⟩ ⟨7, by decide⟩)
  let isHurwitz :=
    (decide (q.w.b = 0) && decide (q.x.b = 0) && decide (q.y.b = 0) && decide (q.z.b = 0)) &&
    ((decide (q.w.a = 2) || decide (q.w.a = -2)) &&
     (decide (q.x.a = 2) || decide (q.x.a = -2)) &&
     (decide (q.y.a = 2) || decide (q.y.a = -2)) &&
     (decide (q.z.a = 2) || decide (q.z.a = -2)))
  isAxis || isHurwitz || isEvenPermGolden q

def count2IBlk (blk : Fin 10) (p : QuatZ5 → Bool) : Nat :=
  (if p (elem2I blk ⟨0, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨1, by decide⟩) then 1 else 0) +
  (if p (elem2I blk ⟨2, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨3, by decide⟩) then 1 else 0) +
  (if p (elem2I blk ⟨4, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨5, by decide⟩) then 1 else 0) +
  (if p (elem2I blk ⟨6, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨7, by decide⟩) then 1 else 0) +
  (if p (elem2I blk ⟨8, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨9, by decide⟩) then 1 else 0) +
  (if p (elem2I blk ⟨10, by decide⟩) then 1 else 0) + (if p (elem2I blk ⟨11, by decide⟩) then 1 else 0)

def count2I (p : QuatZ5 → Bool) : Nat :=
  count2IBlk ⟨0, by decide⟩ p + count2IBlk ⟨1, by decide⟩ p +
  count2IBlk ⟨2, by decide⟩ p + count2IBlk ⟨3, by decide⟩ p +
  count2IBlk ⟨4, by decide⟩ p + count2IBlk ⟨5, by decide⟩ p +
  count2IBlk ⟨6, by decide⟩ p + count2IBlk ⟨7, by decide⟩ p +
  count2IBlk ⟨8, by decide⟩ p + count2IBlk ⟨9, by decide⟩ p

/-- Upper-triangular hoisted distinctness check (short-circuits for (b2, s2) <= (b1, s1)!). -/
def checkDistinctAgainstBlk (q : QuatZ5) (b1 s1 : Nat) (b2 : Fin 10) : Bool :=
  if decide (b2.val < b1) then
    true
  else
    let chk (s2 : Fin 12) : Bool :=
      if decide (b1 = b2.val) && decide (s2.val ≤ s1) then
        true
      else
        decide (q ≠ elem2I b2 s2)
    chk ⟨0, by decide⟩ && chk ⟨1, by decide⟩ && chk ⟨2, by decide⟩ && chk ⟨3, by decide⟩ &&
    chk ⟨4, by decide⟩ && chk ⟨5, by decide⟩ && chk ⟨6, by decide⟩ && chk ⟨7, by decide⟩ &&
    chk ⟨8, by decide⟩ && chk ⟨9, by decide⟩ && chk ⟨10, by decide⟩ && chk ⟨11, by decide⟩

def checkElem2IUniqueAt (b1 : Fin 10) (s1 : Fin 12) : Bool :=
  let q := elem2I b1 s1
  checkDistinctAgainstBlk q b1.val s1.val ⟨0, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨1, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨2, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨3, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨4, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨5, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨6, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨7, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨8, by decide⟩ &&
  checkDistinctAgainstBlk q b1.val s1.val ⟨9, by decide⟩

private theorem p50_c2 :
    isSO3Z uCyc = true ∧
    isSO3Z rhoGBeta = true ∧
    kreinDefectUL25 mat3Id uCyc lDiag5 = mat3Diag 16 (-11) 16 ∧
    kreinDefectLU25 mat3Id uCyc lDiag5 = mat3Diag 16 16 (-11) ∧
    mat3CharPoly (kreinDefectUL25 mat3Id uCyc lDiag5) =
      mat3CharPoly (kreinDefectLU25 mat3Id uCyc lDiag5) ∧
    mat3Cong uCyc (kreinDefectUL25 mat3Id uCyc lDiag5) =
      kreinDefectLU25 mat3Id uCyc lDiag5 ∧
    diagInertia3 (kreinDefectUL25 mat3Id uCyc lDiag5) = (2, 1, 0) ∧
    diagInertia3 (kreinDefectLU25 mat3Id uCyc lDiag5) = (2, 1, 0) ∧
    mat3CharPoly (kreinDefectUL25 mat3Id rhoGBeta lDiag5) =
      mat3CharPoly (kreinDefectLU25 mat3Id rhoGBeta lDiag5) ∧
    diagInertia3 (kreinDefectUL25 mat3Id rhoGBeta lDiag5) = (2, 1, 0) ∧
    diagInertia3 (kreinDefectLU25 mat3Id rhoGBeta lDiag5) = (2, 1, 0) := by decide

private theorem p50_c4_unique :
    ∀ blk : Fin 10, ∀ slt : Fin 12, checkElem2IUniqueAt blk slt = true := by decide

private theorem p50_c4_closure_and_margin :
    ∀ blk : Fin 10, ∀ slt : Fin 12,
      q5NormSq (elem2I blk slt) = ⟨16, 0⟩ ∧
      isElem2IB (elem2I blk slt) = true ∧
      isElem2IB (uMul2I tau0_4 (elem2I blk slt)) = true ∧
      isElem2IB (uMul2I gBeta_4 (elem2I blk slt)) = true ∧
      holonomyBlock2I_16 (q5Neg (elem2I blk slt)) = holonomyBlock2I_16 (elem2I blk slt) ∧
      (elem2I blk slt = I4 ∨ elem2I blk slt = negI4 ∨
       z5PosB (z5Sub ⟨24, -8⟩ (holonomyBlock2I_16 (elem2I blk slt))) = false) := by decide

private theorem p50_c4_counts :
    holonomyBlock2I_16 I4 = ⟨-16, 0⟩ ∧
    holonomyBlock2I_16 tau0_4 = ⟨24, -8⟩ ∧
    z5PosB ⟨24, -8⟩ = true ∧
    count2I (fun g => z5PosB (z5Neg (holonomyBlock2I_16 g))) = 2 ∧
    count2I (fun g => decide (holonomyBlock2I_16 g = z5Zero)) = 0 ∧
    count2I (fun g => z5PosB (holonomyBlock2I_16 g)) = 118 := by decide

/-- Theorem #50 (Track S120 BRIDGE_12 — Non-Scalar Krein-Holonomy Phase Detector K_t):
    Proved with ZERO Classical.choice ([propext, Quot.sound] only)! -/
theorem p50_bridge12_nonscalar_krein_holonomy_order_split
    (p m : Mat3Z) (v : Vec3Z) {c1 c2 : Int} (hc1 : 0 < c1) (hc2 : 0 < c2)
    (q : QuatZ) (hunit : qzNormSq q = 1) :
    (quadForm3 (mat3Cong p m) v = quadForm3 m (mat3Vec p v)) ∧
    (isSO3Z uCyc = true ∧
     isSO3Z rhoGBeta = true ∧
     kreinDefectUL25 mat3Id uCyc lDiag5 = mat3Diag 16 (-11) 16 ∧
     kreinDefectLU25 mat3Id uCyc lDiag5 = mat3Diag 16 16 (-11) ∧
     mat3CharPoly (kreinDefectUL25 mat3Id uCyc lDiag5) =
       mat3CharPoly (kreinDefectLU25 mat3Id uCyc lDiag5) ∧
     mat3Cong uCyc (kreinDefectUL25 mat3Id uCyc lDiag5) =
       kreinDefectLU25 mat3Id uCyc lDiag5 ∧
     diagInertia3 (kreinDefectUL25 mat3Id uCyc lDiag5) = (2, 1, 0) ∧
     diagInertia3 (kreinDefectLU25 mat3Id uCyc lDiag5) = (2, 1, 0) ∧
     mat3CharPoly (kreinDefectUL25 mat3Id rhoGBeta lDiag5) =
       mat3CharPoly (kreinDefectLU25 mat3Id rhoGBeta lDiag5) ∧
     diagInertia3 (kreinDefectUL25 mat3Id rhoGBeta lDiag5) = (2, 1, 0) ∧
     diagInertia3 (kreinDefectLU25 mat3Id rhoGBeta lDiag5) = (2, 1, 0)) ∧
    (kreinDefectUL25 g311 uCyc lDiag5 = mat3Diag 66 (-83) 16 ∧
     kreinDefectLU25 g311 uCyc lDiag5 = mat3Diag 66 (-2) (-11) ∧
     diagInertia3 (kreinDefectUL25 g311 uCyc lDiag5) = (2, 1, 0) ∧
     diagInertia3 (kreinDefectLU25 g311 uCyc lDiag5) = (1, 2, 0) ∧
     diagInertia3 (kreinDefectUL25 g311 rhoGBeta lDiag5) = (2, 1, 0) ∧
     diagInertia3 (kreinDefectLU25 g311 rhoGBeta lDiag5) = (1, 2, 0) ∧
     diagInertia3 (kreinDefectUL25 g114 uCyc lDiag5) = (1, 2, 0) ∧
     diagInertia3 (kreinDefectLU25 g114 uCyc lDiag5) = (2, 1, 0) ∧
     mat3Scale c1 (mat3Cong p (kreinDefectUL25 g311 uCyc lDiag5)) ≠
       mat3Scale c2 (kreinDefectLU25 g311 uCyc lDiag5) ∧
     mat3Scale c1 (mat3Cong p (kreinDefectLU25 g311 uCyc lDiag5)) ≠
       mat3Scale c2 (kreinDefectUL25 g311 uCyc lDiag5)) ∧
    ((holonomyBlockZ (qzNeg q) = holonomyBlockZ q ∧
      holonomyBlockZ q ≠ 0 ∧
      (holonomyBlockZ q < 0 ↔ (q = qzPosI ∨ q = qzNegI)) ∧
      ((q = qzPosI ∨ q = qzNegI) → holonomyBlockZ q = -1) ∧
      ((q ≠ qzPosI ∧ q ≠ qzNegI) → holonomyBlockZ q = 3)) ∧
     ((∀ blk : Fin 10, ∀ slt : Fin 12, checkElem2IUniqueAt blk slt = true) ∧
      (∀ blk : Fin 10, ∀ slt : Fin 12,
        q5NormSq (elem2I blk slt) = ⟨16, 0⟩ ∧
        isElem2IB (elem2I blk slt) = true ∧
        isElem2IB (uMul2I tau0_4 (elem2I blk slt)) = true ∧
        isElem2IB (uMul2I gBeta_4 (elem2I blk slt)) = true ∧
        holonomyBlock2I_16 (q5Neg (elem2I blk slt)) = holonomyBlock2I_16 (elem2I blk slt) ∧
        (elem2I blk slt = I4 ∨ elem2I blk slt = negI4 ∨
         z5PosB (z5Sub ⟨24, -8⟩ (holonomyBlock2I_16 (elem2I blk slt))) = false)) ∧
      holonomyBlock2I_16 I4 = ⟨-16, 0⟩ ∧
      holonomyBlock2I_16 tau0_4 = ⟨24, -8⟩ ∧
      z5PosB ⟨24, -8⟩ = true ∧
      count2I (fun g => z5PosB (z5Neg (holonomyBlock2I_16 g))) = 2 ∧
      count2I (fun g => decide (holonomyBlock2I_16 g = z5Zero)) = 0 ∧
      count2I (fun g => z5PosB (holonomyBlock2I_16 g)) = 118)) := by
  refine ⟨mat3Cong_quadForm p m v, p50_c2, ?_,
          ⟨holonomyBlockZ_unit_dichotomy q hunit,
           ⟨p50_c4_unique, p50_c4_closure_and_margin,
            p50_c4_counts.1, p50_c4_counts.2.1, p50_c4_counts.2.2.1,
            p50_c4_counts.2.2.2.1, p50_c4_counts.2.2.2.2.1, p50_c4_counts.2.2.2.2.2⟩⟩⟩
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, ?_, ?_⟩
  · intro heq
    exact sylvester_no_cong_ul_to_lu p hc1 hc2 heq
  · intro heq
